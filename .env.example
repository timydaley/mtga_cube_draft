# Copy to .env and fill in. Never commit .env.

# Cloudflare R2 (object storage for datasets + checkpoints)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cube-draft

# Weights & Biases (experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=cube-draft

# RunPod (optional — used by scripts/runpod_launch.py)
RUNPOD_API_KEY=
